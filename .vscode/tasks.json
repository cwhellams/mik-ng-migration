{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Lint SQL with SQLFluff",
      "type": "shell",
      "command": "sqlfluff lint ${file}",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        {
          "owner": "sqlfluff",
          "fileLocation": ["relative", "${workspaceFolder}"],
          "pattern": {
            "regexp": "^\\s*(?<file>[^:]+):(?<line>\\d+):(?<column>\\d+):\\s*(?<message>.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "message": 4
          }
        }
      ]
    }
  ]
}

{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Vite + Chrome",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/src"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run Gmail File",
      "runtimeArgs": ["--experimental-transform-types"],
      "program": "${file}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Program",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/apps/backend/test/lib/sendGmail.test.ts",
      "outFiles": ["${workspaceFolder}/**/*.js"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Backend (Native TypeScript)",
      "cwd": "${workspaceFolder}/apps/backend",
      "program": "${workspaceFolder}/apps/backend/src/app.ts",
      "runtimeArgs": ["--import=tsx"],
      "outputCapture": "std",
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Jest with ts-jest (ESM)",
      "cwd": "${workspaceFolder}/apps/backend",
      "program": "${workspaceFolder}/apps/backend/node_modules/jest/bin/jest.js",
      "args": [
        "--runInBand",
        "--no-cache",        
        "test/routes/members/api.test.ts",
      ],
      "env": {
        "NODE_ENV": "test"
      },
      "runtimeArgs": ["--experimental-vm-modules"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Current Jest Test",
      "cwd": "${workspaceFolder}/apps/backend",
      "program": "${workspaceFolder}/apps/backend/node_modules/jest/bin/jest.js",
      "args": ["--runInBand", "--no-cache", "${relativeFile}"],
      "env": {
        "NODE_ENV": "test"
      },
      "runtimeArgs": ["--experimental-vm-modules"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug SimplBooks Sync",
      "cwd": "${workspaceFolder}/apps/simplbooks_sync",
      "program": "${workspaceFolder}/apps/simplbooks_sync/src/index.ts",
      "runtimeArgs": ["--import=tsx"],
      "outputCapture": "std",
      "skipFiles": ["<node_internals>/**"],
      "envFile": "${workspaceFolder}/apps/simplbooks_sync/.env",
      "console": "integratedTerminal"
    }
  ]
}

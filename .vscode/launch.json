{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Run Gmail File",
            "runtimeArgs": ["--experimental-transform-types"],
            "program": "${file}",
            "console": "integratedTerminal",
             "skipFiles": [
                "<node_internals>/**"
            ],
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Program",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/apps/backend/test/lib/sendGmail.test.ts",
            "outFiles": [
                "${workspaceFolder}/**/*.js"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Backend (Native TypeScript)",
            "cwd": "${workspaceFolder}/apps/backend",
            "program": "${workspaceFolder}/apps/backend/src/app.ts",
            "runtimeArgs": ["--import=tsx"],
            "outputCapture": "std",
            "skipFiles": ["<node_internals>/**"],
            "env": {
                "NODE_ENV": "development"
            }
            }
    ]
}
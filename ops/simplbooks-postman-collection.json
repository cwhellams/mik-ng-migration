{
  "info": {
    "name": "SimplBooks API v1",
    "description": "Complete Postman collection for the SimplBooks API. Set the `simplbooks_api_key` and `simplbooks_company_id` collection variables before use.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "simplbooks_api_key",
      "value": "YOUR_API_KEY_HERE",
      "description": "Your SimplBooks API token (X-Simplbooks-Token header)"
    },
    {
      "key": "simplbooks_company_id",
      "value": "YOUR_COMPANY_ID_HERE",
      "description": "Your SimplBooks company ID (appears in the URL)"
    },
    {
      "key": "base_url",
      "value": "https://app.simplbooks.com/{{simplbooks_company_id}}/api",
      "description": "Base URL — do not edit directly, change company_id variable instead"
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "X-Simplbooks-Token" },
      { "key": "value", "value": "{{simplbooks_api_key}}" },
      { "key": "in", "value": "header" }
    ]
  },
  "item": [
    {
      "name": "Items (Articles)",
      "item": [
        {
          "name": "Get Item",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/articles/get/{{article_id}}",
            "description": "Get information about the item with given ID."
          }
        },
        {
          "name": "List Items",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/articles/list",
            "header": [{ "key": "X-Input-Format", "value": "json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"name\": \"\",\n  \"code\": \"\",\n  \"ean\": \"\",\n  \"page\": 1,\n  \"per_page\": 10\n}"
            },
            "description": "Returns list of items matching given criteria."
          }
        },
        {
          "name": "Create Item",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/articles/create",
            "header": [{ "key": "X-Input-Format", "value": "json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"Article\": {\n    \"code\": \"A-001\",\n    \"name\": \"Item name\",\n    \"unit\": \"pcs\",\n    \"amount\": 1,\n    \"price_per_unit\": 0.00,\n    \"active\": true\n  }\n}"
            },
            "description": "Create new item based on given parameters."
          }
        },
        {
          "name": "Update Item",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/articles/update",
            "header": [{ "key": "X-Input-Format", "value": "json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"Article\": {\n    \"id\": 0,\n    \"code\": \"A-001\",\n    \"name\": \"Item name\",\n    \"unit\": \"pcs\",\n    \"price_per_unit\": 0.00,\n    \"active\": true\n  }\n}"
            },
            "description": "Updates existing item info with information from given parameters."
          }
        },
        {
          "name": "Delete Item",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/articles/delete/{{article_id}}",
            "description": "Deletes the item with the given ID."
          }
        },
        {
          "name": "Item Remnant (Stock)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/articles/remnant/{{article_id}}",
            "header": [{ "key": "X-Input-Format", "value": "json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"warehouse_id\": null,\n  \"date\": \"{{$isoTimestamp}}\"\n}"
            },
            "description": "Returns current remaining stock of the item with the given ID."
          }
        }
      ]
    },

{
  "name": "edge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cloudflare Worker that serves the built SPA bundle and proxies the API paths to the origin, keeping both on one hostname",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "assets": "./scripts/build-assets.sh",
    "dev": "pnpm run assets && wrangler dev",
    "deploy": "pnpm run assets && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260822.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.5",
    "admin": "workspace:*",
    "frontend": "workspace:*",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.129.0"
  }
}

{
  "name": "mik_ng-backend-service",
  "version": "1.0.0",
  "description": "mik_ng backend service to support new MIK website and intranet",
  "main": "src/app.ts",
  "scripts": {
    "start": "ts-node src/app.ts",
    "dev": "nodemon src/app.ts",
    "build": "tsc",
    "schema": "kysely-codegen --out-file ./src/db/schema.d.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --detectOpenHandles --forceExit --logHeapUsage --runInBand"
  },
  "jest": {
    "reporters": [
      "default",
      "jest-junit"
    ],
    "collectCoverage": false,
    "coverageReporters": [
      "json",
      "lcov",
      "text",
      "clover"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "js",
      "json",
      "node"
    ]
  },
  "keywords": [],
  "author": "mik_ng team",
  "license": "ISC",
  "packageManager": "pnpm@10.5.2",
  "dependencies": {    
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^146.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.27.6",
    "morgan": "^1.10.0",
    "ms": "^2.1.3",
    "pg": "^8.13.3",
    "rate-limiter-flexible": "^5.0.5",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/ms": "^2.1.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.11.11",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "kysely-codegen": "^0.18.2",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.3",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}

{
  "name": "mik_ng-backend-service",
  "version": "1.0.0",
  "description": "mik_ng backend service to support new MIK website and intranet",
  "main": "src/app.ts",
  "type": "module",
  "scripts": {
    "start": "tsx src/app.ts",
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "schema": "kysely-codegen --numeric-parser number --date-parser string --dialect postgres --out-file ./src/db/schema.d.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "cross-env DISABLE_EMAIL_SENDING=true NODE_OPTIONS=\"--loader ts-node/esm\" node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles --forceExit --logHeapUsage --runInBand",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix"
  },
  "jest": {
    "globalTeardown": "./test/global-teardown.ts",
    "preset": "ts-jest/presets/default-esm",
    "reporters": [
      "default",
      "jest-junit"
    ],
    "collectCoverage": true,
    "coverageReporters": [
      "json",
      "lcov",
      "text",
      "clover"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "coverageDirectory": "coverage",
    "coveragePathIgnorePatterns": [
      "/test/"
    ],
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json",
          "useESM": true
        }
      ]
    },
    "testPathIgnorePatterns": [
      "/integration_test/"
    ],
    "globals": {
      "ts-jest": {
        "useESM": true
      }
    },
    "moduleFileExtensions": [
      "ts",
      "js",
      "json",
      "node"
    ]
  },

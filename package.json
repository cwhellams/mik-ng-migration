{
  "name": "mik-ng",
  "version": "1.0.15",
  "private": true,
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"pnpm --filter mik_ng-backend-service dev\" \"pnpm --filter frontend dev\"",
    "build": "pnpm --recursive run build",
    "start": "pnpm --recursive run start",
    "test": "pnpm --recursive --reporter append-only run test",
    "lint": "pnpm --recursive run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "clean": "pnpm --recursive run clean",
    "typecheck": "pnpm --recursive run typecheck",
    "version:major": "npm version major",
    "version:minor": "npm version minor",
    "version:patch": "npm version patch"
  },
  "keywords": [],
  "author": "Malmin Ilmailukerho ry",
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@changesets/cli": "^2.0.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "prettier": "^3.5.2",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "axios": "^1.13.2"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@3.14.1": "3.14.2",
      "js-yaml@4.1.0": "4.1.1"
    }
  }
}

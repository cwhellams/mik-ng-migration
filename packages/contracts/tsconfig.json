{
  "compilerOptions": {
    "target": "esnext",
    /* No "types" and no @types/node: the package must compile against
       web-standard globals only, so a stray `process.env` or `Buffer` is a
       compile error here rather than a runtime crash in the browser bundle. */
    "lib": ["ESNext", "DOM"],
    "types": [],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  /* src/ ONLY. Do not add test/ or vitest.config.ts here: pulling Vitest's types
     into this program brings Node's ambient globals with them, and `process.env`
     in a contract would start typechecking again — which is the exact leak the
     "types": [] above exists to catch. Tests are typechecked separately by
     tsconfig.test.json. */
  "include": ["src/**/*.ts"]
}

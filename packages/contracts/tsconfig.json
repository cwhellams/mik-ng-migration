{
  "compilerOptions": {
    "target": "esnext",
    /* No "types" and no @types/node: the package must compile against
       web-standard globals only, so a stray `process.env` or `Buffer` is a
       compile error here rather than a runtime crash in the browser bundle. */
    "lib": ["ESNext", "DOM"],
    "types": [],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}

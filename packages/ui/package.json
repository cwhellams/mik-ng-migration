{
  "name": "@mik/ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Presentation-layer code (generic MUI components, browser utils and the i18n bundle) shared by apps/frontend and apps/admin",
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./locales/*": "./src/locales/*.json",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@iconify/react": "^6.0.2",
    "@mik/contracts": "workspace:*",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/system": "9.2.0",
    "axios": "^1.19.0",
    "country-telephone-data": "^0.6.3",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.21",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "react-i18next": "^17.0.11",
    "react-router": "^8.3.0",
    "swr": "^2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/crypto-js": "^4.2.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
